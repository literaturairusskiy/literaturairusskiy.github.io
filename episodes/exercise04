
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>В каком году? Какой год? Говорить как?</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f3ec;color:#292c26;font-family:Arial,sans-serif;line-height:1.6}
main{max-width:850px;margin:auto;padding:28px 16px 60px}
h1{font-size:clamp(28px,5vw,42px);line-height:1.15;margin:8px 0}
h2{font-size:22px;margin:0 0 5px}
p{margin:8px 0}
.subtitle{color:#6c7168}
.section{background:white;border:1px solid #e5e2d8;border-radius:18px;padding:24px;margin:18px 0}
.heading{display:flex;gap:13px;align-items:center;margin-bottom:18px}
.number{background:#e6eee2;color:#426447;border-radius:12px;padding:8px 12px;font-weight:bold}
.item{padding:15px 0;border-top:1px solid #eeeae1}
.question{font-weight:bold;margin-bottom:9px}
.options{display:flex;flex-wrap:wrap;gap:9px}
.choice{border:1px solid #deded5;border-radius:10px;padding:8px 12px;cursor:pointer}
.choice:has(input:checked){background:#edf3e9;border-color:#6e8c70}
input[type=radio]{accent-color:#486b50}
input[type=text],textarea{width:100%;padding:12px;border:1px solid #d9d9d0;border-radius:10px;font:inherit;background:#fff}
input[type=text]:focus,textarea:focus{outline:2px solid #b8cdb5;border-color:#789478}
textarea{min-height:80px;resize:vertical}
.feedback{display:none;margin-top:9px;padding:9px 12px;border-radius:9px;font-size:14px}
.feedback.show{display:block}
.correct{background:#e8f4e9;color:#276b39}
.incorrect{background:#faeae8;color:#a02f29}
.neutral{background:#f2f0e9;color:#555}
.example{background:#f7f6f0;border-radius:10px;padding:12px 14px;margin:10px 0}
.example strong{color:#486b50;font-size:12px;text-transform:uppercase;letter-spacing:.06em}
.example p{margin:4px 0}
.open-item{margin:18px 0}
.open-item label{display:block;font-weight:bold;margin-bottom:7px}
button{font:inherit;font-weight:bold;border:0;border-radius:11px;padding:12px 17px;cursor:pointer}
.primary{background:#486b50;color:white}
.secondary{background:#e8e6dd;color:#292c26}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
#result{display:none;background:#e8f0e4;border-radius:12px;padding:18px;margin:18px 0}
#result.show{display:block}
.small{font-size:13px;color:#73766e}
@media(max-width:520px){.section{padding:17px}.choice{width:100%}}
</style>
</head>
<body>
<main>
<header>
<p style="color:#486b50;font-weight:bold;letter-spacing:.1em">РУССКИЙ КАК ИНОСТРАННЫЙ · A1–A2</p>
<h1>Как? Что? В каком году?</h1>
<p class="subtitle">Выполните первые четыре задания и проверьте ответы. В задании 5 напишите ответы о себе или используйте их для устной практики.</p>
</header>

<form id="quiz">

<section class="section">
<div class="heading"><span class="number">01</span><div><h2>Выберите правильный вариант</h2><p class="subtitle">Как? Что?</p></div></div>

<div class="item" data-answer="b" data-type="radio">
<div class="question">1. Я хорошо говорю …</div>
<div class="options">
<label class="choice"><input type="radio" name="q1" value="a"> русский язык</label>
<label class="choice"><input type="radio" name="q1" value="b"> по-русски</label>
<label class="choice"><input type="radio" name="q1" value="c"> русском</label>
</div><div class="feedback"></div>
</div>

<div class="item" data-answer="c" data-type="radio">
<div class="question">2. Моя подруга изучает …</div>
<div class="options">
<label class="choice"><input type="radio" name="q2" value="a"> по-китайски</label>
<label class="choice"><input type="radio" name="q2" value="b"> китайском</label>
<label class="choice"><input type="radio" name="q2" value="c"> китайский язык</label>
</div><div class="feedback"></div>
</div>

<div class="item" data-answer="a" data-type="radio">
<div class="question">3. Мы читаем …</div>
<div class="options">
<label class="choice"><input type="radio" name="q3" value="a"> по-английски</label>
<label class="choice"><input type="radio" name="q3" value="b"> английский язык</label>
<label class="choice"><input type="radio" name="q3" value="c"> английском</label>
</div><div class="feedback"></div>
</div>

<div class="item" data-answer="b" data-type="radio">
<div class="question">4. Он пишет …</div>
<div class="options">
<label class="choice"><input type="radio" name="q4" value="a"> по-русский</label>
<label class="choice"><input type="radio" name="q4" value="b"> по-русски</label>
<label class="choice"><input type="radio" name="q4" value="c"> русский язык</label>
</div><div class="feedback"></div>
</div>

<div class="item" data-answer="b" data-type="radio">
<div class="question">5. Студенты думают …</div>
<div class="options">
<label class="choice"><input type="radio" name="q5" value="a"> русский язык</label>
<label class="choice"><input type="radio" name="q5" value="b"> по-русски</label>
<label class="choice"><input type="radio" name="q5" value="c"> русском языке</label>
</div><div class="feedback"></div>
</div>
</section>

<section class="section">
<div class="heading"><span class="number">02</span><div><h2>Дополните предложения</h2><p class="subtitle">Введите нужную форму.</p></div></div>

<div class="item" data-answers="по-русски">
<div class="question">1. Я хорошо говорю … (русский язык).</div>
<input type="text" name="q6" placeholder="Ваш ответ"><div class="feedback"></div>
</div>
<div class="item" data-answers="по-английски">
<div class="question">2. Мой друг читает … (английский язык).</div>
<input type="text" name="q7" placeholder="Ваш ответ"><div class="feedback"></div>
</div>
<div class="item" data-answers="китайский язык">
<div class="question">3. Мы изучаем … (китайский язык).</div>
<input type="text" name="q8" placeholder="Ваш ответ"><div class="feedback"></div>
</div>
<div class="item" data-answers="по-русски">
<div class="question">4. Она пишет … (русский язык).</div>
<input type="text" name="q9" placeholder="Ваш ответ"><div class="feedback"></div>
</div>
<div class="item" data-answers="по-английски">
<div class="question">5. Я думаю … (английский язык).</div>
<input type="text" name="q10" placeholder="Ваш ответ"><div class="feedback"></div>
</div>
<p class="small">Говорить, читать, писать, думать — как? Изучать — что?</p>
</section>

<section class="section">
<div class="heading"><span class="number">03</span><div><h2>Какой это год?</h2><p class="subtitle">Напишите год словами.</p></div></div>
<div class="example"><strong>Пример</strong><p>1991 — тысяча девятьсот девяносто первый.</p></div>

<div class="item" data-answers="тысяча девятьсот восемьдесят седьмой">
<div class="question">1. 1987 —</div>
<input type="text" name="q11" placeholder="Напишите год словами"><div class="feedback"></div>
</div>
<div class="item" data-answers="тысяча девятьсот девяносто девятый">
<div class="question">2. 1999 —</div>
<input type="text" name="q12" placeholder="Напишите год словами"><div class="feedback"></div>
</div>
<div class="item" data-answers="две тысячи пятый">
<div class="question">3. 2005 —</div>
<input type="text" name="q13" placeholder="Напишите год словами"><div class="feedback"></div>
</div>
<div class="item" data-answers="две тысячи десятый">
<div class="question">4. 2010 —</div>
<input type="text" name="q14" placeholder="Напишите год словами"><div class="feedback"></div>
</div>
<div class="item" data-answers="две тысячи двадцать четвертый|две тысячи двадцать четвёртый">
<div class="question">5. 2024 —</div>
<input type="text" name="q15" placeholder="Напишите год словами"><div class="feedback"></div>
</div>
</section>

<section class="section">
<div class="heading"><span class="number">04</span><div><h2>В каком году?</h2><p class="subtitle">Напишите числительное в правильной форме.</p></div></div>
<div class="example"><strong>Пример</strong><p>1999 — в тысяча девятьсот девяносто девятом году.</p></div>

<div class="item" data-answers="тысяча семьсот девяносто девятом">
<div class="question">1. В каком году родился Александр Пушкин? (1799)</div>
<p class="small">В … году.</p><input type="text" name="q16" placeholder="Введите числительное"><div class="feedback"></div>
</div>
<div class="item" data-answers="тысяча девятьсот сорок пятом">
<div class="question">2. В каком году закончилась Вторая мировая война? (1945)</div>
<p class="small">В … году.</p><input type="text" name="q17" placeholder="Введите числительное"><div class="feedback"></div>
</div>
<div class="item" data-answers="две тысячи первом">
<div class="question">3. В каком году начался XXI век? (2001)</div>
<p class="small">В … году.</p><input type="text" name="q18" placeholder="Введите числительное"><div class="feedback"></div>
</div>
<div class="item" data-answers="тысяча девятьсот девяностом">
<div class="question">4. В каком году открылась школа? (1990)</div>
<p class="small">В … году.</p><input type="text" name="q19" placeholder="Введите числительное"><div class="feedback"></div>
</div>
<div class="item" data-answers="две тысячи двадцать четвертом|две тысячи двадцать четвёртом">
<div class="question">5. В каком году начался 2024 год?:)) (2024)</div>
<p class="small">В … году.</p><input type="text" name="q20" placeholder="Введите числительное"><div class="feedback"></div>
</div>
<p class="small">Введите только числительное. Не нужно писать «в» и «году».</p>
</section>

<section class="section">
<div class="heading"><span class="number">05</span><div><h2>Интервью о себе</h2><p class="subtitle">Напишите ответы или ответьте устно.</p></div></div>

<div class="open-item">
<label for="open1">1. В каком году вы родились?</label>
<textarea id="open1" placeholder="Я родился / родилась в … году."></textarea>
<div class="example"><strong>Пример ответа</strong><p>Я родилась в тысяча девятьсот девяносто девятом году.</p></div>
</div>

<div class="open-item">
<label for="open2">2. В каком году вы начали учиться в школе?</label>
<textarea id="open2" placeholder="Я начал / начала учиться в школе в … году."></textarea>
<div class="example"><strong>Пример ответа</strong><p>Я начала учиться в школе в две тысячи шестом году.</p></div>
</div>

<div class="open-item">
<label for="open3">3. В каком году вы начали учиться в университете?</label>
<textarea id="open3" placeholder="Я начал / начала учиться в университете в … году."></textarea>
<div class="example"><strong>Пример ответа</strong><p>Я начал учиться в университете в две тысячи пятнадцатом году.</p></div>
</div>

<div class="open-item">
<label for="open4">4. Когда вы начали изучать русский язык?</label>
<textarea id="open4" placeholder="Я начал / начала изучать русский язык …"></textarea>
<div class="example"><strong>Пример ответа</strong><p>Я начала изучать русский язык в две тысячи двадцатом году.</p></div>
</div>

<div class="open-item">
<label for="open5">5. На каких языках вы читаете, пишете и говорите?</label>
<textarea id="open5" placeholder="Я читаю …, пишу … и говорю …"></textarea>
<div class="example"><strong>Пример ответа</strong><p>Я читаю по-русски и по-английски, пишу по-русски и говорю по-русски, по-английски и по-китайски.</p></div>
</div>
<p class="small">Примеры условные. Используйте свои даты и информацию о себе.</p>
</section>

<div class="actions">
<button type="button" class="primary" id="check">Проверить ответы 1–4</button>
<button type="reset" class="secondary" id="reset">Начать заново</button>
</div>
</form>
<div id="result" aria-live="polite"></div>
</main>

<script>
function normalize(s){
 return s.toLocaleLowerCase('ru-RU')
 .replace(/ё/g,'е')
 .replace(/[.,!?;:]/g,' ')
 .replace(/[—–-]/g,' ')
 .replace(/\s+/g,' ').trim();
}

document.getElementById('check').addEventListener('click',function(){
 let score=0,total=0,answered=0;

 document.querySelectorAll('.section').forEach((section,index)=>{
   if(index===4)return;
   section.querySelectorAll('.item').forEach(item=>{
     total++;
     const feedback=item.querySelector('.feedback');
     let value='',correct=false,expected='';

     if(item.dataset.type==='radio'){
       const selected=item.querySelector('input[type=radio]:checked');
       if(selected)value=selected.value;
       const correctValue=item.dataset.answer;
       const correctLabel=item.querySelector('input[value="'+correctValue+'"]').parentElement.textContent.trim();
       expected=correctLabel;
       correct=!!value&&value===correctValue;
     }else{
       const input=item.querySelector('input[type=text]');
       value=input.value;
       const accepted=(item.dataset.answers||'').split('|');
       expected=accepted[0];
       correct=!!value.trim()&&accepted.some(a=>normalize(a)===normalize(value));
     }

     feedback.className='feedback show';
     if(!value.trim()){
       feedback.classList.add('neutral');
       feedback.textContent='Введите или выберите ответ.';
       return;
     }
     answered++;
     if(correct){
       score++;
       feedback.classList.add('correct');
       feedback.textContent='Верно!';
     }else{
       feedback.classList.add('incorrect');
       feedback.textContent='Правильный ответ: '+expected+'.';
     }
   });
 });

 const result=document.getElementById('result');
 result.className='show';
 result.innerHTML='<strong>Результат: '+score+' из '+total+' баллов</strong><p>Вы ответили на '+answered+' из '+total+' вопросов. Проверьте ошибки и попробуйте ещё раз. Задание 5 предназначено для самостоятельной практики.</p>';
 result.scrollIntoView({behavior:'smooth',block:'center'});
});

document.getElementById('reset').addEventListener('click',function(){
 setTimeout(()=>{
  document.querySelectorAll('.feedback').forEach(f=>{f.className='feedback';f.textContent='';});
  const result=document.getElementById('result');
  result.className='';
  result.textContent='';
 },0);
});
</script>
</body>
</html>

